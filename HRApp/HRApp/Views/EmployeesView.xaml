<UserControl x:Class="HRApp.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="{DynamicResource BtnAdd}" Padding="12,6" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="{DynamicResource BtnEdit}" Padding="12,6" Margin="0,0,8,0" Click="Edit_Click"/>
            <Button Content="{DynamicResource BtnDelete}" Padding="12,6" Click="Delete_Click"/>
        </StackPanel>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource ColNameEn}" Binding="{Binding FullNameEn}" Width="140"/>
                <DataGridTextColumn Header="{DynamicResource ColNameAr}" Binding="{Binding FullNameAr}" Width="140"/>
                <DataGridTextColumn Header="{DynamicResource ColDepartment}" Binding="{Binding Department}" Width="120"/>
                <DataGridTextColumn Header="{DynamicResource ColPosition}" Binding="{Binding Position}" Width="120"/>
                <DataGridTextColumn Header="{DynamicResource ColGender}" Binding="{Binding Gender}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource ColHireDate}" Binding="{Binding HireDate, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="{DynamicResource ColSalary}" Binding="{Binding Salary, StringFormat=N0}" Width="90"/>
                <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="{DynamicResource ColPhone}" Binding="{Binding Phone}" Width="110"/>
                <DataGridTextColumn Header="{DynamicResource ColEmail}" Binding="{Binding Email}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
