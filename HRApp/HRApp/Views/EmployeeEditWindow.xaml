<Window x:Class="HRApp.Views.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource EditTitle}" Height="620" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource ColNameEn}"/>
        <TextBox x:Name="TxtNameEn" Margin="0,4,0,12"/>

        <TextBlock Text="{DynamicResource ColNameAr}"/>
        <TextBox x:Name="TxtNameAr" Margin="0,4,0,12" FlowDirection="RightToLeft"/>

        <TextBlock Text="{DynamicResource ColDepartment}"/>
        <TextBox x:Name="TxtDepartment" Margin="0,4,0,12"/>

        <TextBlock Text="{DynamicResource ColPosition}"/>
        <TextBox x:Name="TxtPosition" Margin="0,4,0,12"/>

        <TextBlock Text="{DynamicResource ColGender}"/>
        <ComboBox x:Name="CmbGender" Margin="0,4,0,12">
            <ComboBoxItem Content="Male"/>
            <ComboBoxItem Content="Female"/>
        </ComboBox>

        <TextBlock Text="{DynamicResource ColHireDate}"/>
        <DatePicker x:Name="DpHireDate" Margin="0,4,0,12"/>

        <TextBlock Text="{DynamicResource ColSalary}"/>
        <TextBox x:Name="TxtSalary" Margin="0,4,0,12"/>

        <TextBlock Text="{DynamicResource ColStatus}"/>
        <ComboBox x:Name="CmbStatus" Margin="0,4,0,12">
            <ComboBoxItem Content="Active"/>
            <ComboBoxItem Content="Inactive"/>
        </ComboBox>

        <TextBlock Text="{DynamicResource ColPhone}"/>
        <TextBox x:Name="TxtPhone" Margin="0,4,0,12"/>

        <TextBlock Text="{DynamicResource ColEmail}"/>
        <TextBox x:Name="TxtEmail" Margin="0,4,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource BtnCancel}" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="{DynamicResource BtnSave}" Padding="14,6" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
